{
  "name": "ironiq/gitzenith",
  "description": "An elegant git repository viewer",
  "keywords": ["scm", "vcs", "git", "repository", "gitweb"],
  "type": "project",
  "license": "BSD-3-Clause",
  "require": {
    "php": ">=8.2",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "league/commonmark": "^2.8",
    "nesbot/carbon": "^3.10",
    "symfony/asset": "^7.4",
    "symfony/cache": "^7.4",
    "symfony/cache-contracts": "^3.5",
    "symfony/clock": "^7.4",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/deprecation-contracts": "^3.5",
    "symfony/dotenv": "^7.4",
    "symfony/error-handler": "^7.4",
    "symfony/event-dispatcher": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.5",
    "symfony/filesystem": "^7.4",
    "symfony/finder": "^7.4",
    "symfony/form": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/monolog-bridge": "^7.4",
    "symfony/monolog-bundle": "^4.1",
    "symfony/options-resolver": "^7.4",
    "symfony/process": "^7.4",
    "symfony/property-access": "^7.4",
    "symfony/property-info": "^7.4",
    "symfony/routing": "^7.4",
    "symfony/stopwatch": "^7.4",
    "symfony/service-contracts": "^3.5",
    "symfony/string": "^7.4",
    "symfony/translation": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/translation-contracts": "^3.6",
    "symfony/webpack-encore-bundle": "^2.3",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.86",
    "phpspec/prophecy-phpunit": "^2.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11.5",
    "symfony/debug-bundle": "^7.4",
    "symfony/phpunit-bridge": "^8.1",
    "symfony/var-dumper": "^7.4",
    "symfony/web-profiler-bundle": "^7.4"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "process-timeout": 0
  },
  "autoload": {
    "psr-4": {
      "GitZenith\\": "src/"
    }
  },
  "scripts": {
    "auto-scripts": [
      "bin/console cache:clear",
      "bin/console assets:install --symlink --relative public"
    ],
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test": [
      "@cs",
      "@unit",
      "@lint",
      "@stan"
    ],
    "format": [
      "vendor/bin/php-cs-fixer fix -v --show-progress=dots"
    ],
    "lint": [
      "bin/console lint:twig assets/themes/",
      "bin/console lint:yaml assets/translations/",
      "bin/console lint:yaml config/",
      "find src -name '*.php' -print0 | xargs -0 -n1 -P8 php -l"
    ],
    "cs": [
      "vendor/bin/php-cs-fixer fix --dry-run -v --show-progress=dots"
    ],
    "unit": [
      "vendor/bin/phpunit"
    ],
    "stan": [
      "vendor/bin/phpstan analyse -c phpstan.neon -l 5 src/"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false
    }
  }
}
